# Nazm settings. Copy this file to .env and edit it; every setting the app reads is listed here.
# NEXT_PUBLIC_DEMO_MODE and NEXT_PUBLIC_PAYMENTS_ENABLED are compiled into the build: set them before `npm run build`,
# or pass them as Docker build arguments. The other settings are read by the running server.

# --- Core ---
DATABASE_URL="postgresql://nazm:nazm@localhost:5432/nazm?schema=public"
# Optional. Without it, the rate limits and the cache live in the memory of the server process.
REDIS_URL="redis://localhost:6379"
# Required in production. Use at least 32 random characters, different for every server (the app checks only that it
# is set). It signs the session cookie.
SESSION_SECRET="replace-with-at-least-32-random-characters"
# The address people use to reach the app. `npm run verify:deploy` checks this address when none is given.
APP_URL="http://localhost:3000"
# The Docker image sets this to production.
NODE_ENV="development"
# Demo mode (seeded demo@nazm.example login + prefill). Always on outside production; in production
# only when "true". Leave empty for any real deployment.
NEXT_PUBLIC_DEMO_MODE=""
# Plan purchases (billing pages, pricing, payment APIs, admin review). Always on outside production; in
# production only when "true" at build time. Leave empty to keep them off. The BILLING_* settings below belong to it.
NEXT_PUBLIC_PAYMENTS_ENABLED=""

# --- Sign-up and admin ---
# When set, sign-up is invite-only: registering needs this code. Use it for an invite-only server and share the code
# only with the people you invite.
REGISTRATION_INVITE_CODE=""
# Production only: with no invite code sign-up stays closed unless this is "true" (open to everyone).
REGISTRATION_OPEN=""
# Admin bootstrap: comma-separated e-mails (any case) that get the "admin" role when they SIGN IN (registering
# never grants a role), so the Access requests list on /admin works. Empty = nobody. The order is forced:
#   1. register your own account while ADMIN_EMAILS is empty,
#   2. sign in to check the account is yours,
#   3. set ADMIN_EMAILS to that address,
#   4. sign in again.
# While an address is listed and has no account, registering it is refused like a taken address. If registering
# says the address already exists and it is not you, do not list that address.
# It only ever adds the role. To revoke it, delete the person's UserRole row for "admin" (clearing this
# variable does not remove the role), and remove the address here too, or the next sign-in grants it again.
ADMIN_EMAILS=""
# Optional public contact address (one plain e-mail). When set, the privacy page and the request-access success
# card show it as a mailto link and say a person can ask for their request to be deleted there. When empty, the
# pages promise no such route. Read on the server at runtime, so a normal variable is enough (no build argument);
# restart or redeploy after changing it.
NEXT_PUBLIC_CONTACT_EMAIL=""
# Where the app's "Source code" links point (an https:// address; anything else is ignored). Empty = the public
# Nazm repository. If you run a modified copy, the AGPL asks you to offer its source to its users: point this at it.
# Read on the server at runtime, like the contact address above.
NEXT_PUBLIC_SOURCE_URL=""
# Reverse proxies in front of the app that append to X-Forwarded-For (rate limits use the client address
# the nearest trusted proxy saw). 1 for a single proxy. Run the app behind a reverse proxy that sets that header.
TRUSTED_PROXY_HOPS="1"

# --- Coach (AI) ---
# AI_PROVIDER=local | openai. "local" is the built-in rule-based coach and needs no key or outside service.
AI_PROVIDER="local"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# Address of the OpenAI-compatible API to call; change it to use another compatible server.
OPENAI_BASE_URL="https://api.openai.com/v1"
# Calls to the outside provider per user per day; above it the local coach answers.
AI_DAILY_CALL_CAP="50"

# --- Providers that are not implemented yet ---
# Not implemented yet: no e-mail is sent. Only /api/system/options shows this value.
EMAIL_PROVIDER="local"
# Not implemented yet: no market data is fetched. Only /api/system/options shows this value.
MARKET_DATA_PROVIDER="local"

# --- News ---
# External news provider. NEWS_PROVIDER=local | http. With http, NEWS_API_URL is the feed's address (JSON with an
# "articles" or "items" list) and NEWS_API_KEY, when set, is sent as ?apiKey=. Any failure falls back to the local items.
NEWS_PROVIDER="local"
NEWS_API_URL=""
NEWS_API_KEY=""
NEWS_CACHE_TTL_SECONDS="600"

# --- Alert notifications ---
# Notification channels (all optional; unset = log-only fallback)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
DISCORD_WEBHOOK_URL=""
NOTIFICATION_WEBHOOK_URL=""
# Not implemented yet: there is no mail transport. With a value set, the e-mail channel only writes a line to the log.
EMAIL_FROM=""

# --- Payments (optional) ---
# Optional, and only used when payments are on: always outside production, and in production only when
# NEXT_PUBLIC_PAYMENTS_ENABLED=true was set at build time. Plan purchases are manual-review transfers; a method stays
# "not open yet" until it is set. Card-to-card destination (16-digit card number + holder name; bank name optional).
BILLING_CARD_NUMBER=""
BILLING_CARD_HOLDER=""
BILLING_BANK_NAME=""
# USDT on TRC20 (Tron address starting with T). Only public receive addresses; never a private key.
BILLING_USDT_TRC20_ADDRESS=""

