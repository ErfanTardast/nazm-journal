generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  en
  fa
}

enum Theme {
  dark
  light
  system
}

enum Tier {
  free
  pro
  elite
}

enum PaymentMethod {
  card_to_card
  usdt_trc20
}

enum PaymentCurrency {
  toman
  usdt
}

enum PaymentStatus {
  awaiting_transfer
  pending
  approved
  rejected
  refunded
}

enum MarketType {
  crypto
  forex
  stocks
}

enum TradeSide {
  long
  short
}

enum TradeStatus {
  open
  closed
  planned
  canceled
}

enum AlertType {
  price
  indicator
  risk
  journal_reminder
  daily_review
  weekly_review
}

enum AlertStatus {
  active
  triggered
  paused
  archived
}

enum NotificationChannel {
  in_app
  email
  telegram
  discord
  webhook
}

enum TradePlanStatus {
  planned
  active
  closed
  canceled
}

enum RuleFollowStatus {
  followed
  broken
  mixed
  unknown
}

enum TradeImportStatus {
  preview
  imported
  failed
}

enum NewsCategory {
  macro
  central_bank
  inflation
  employment
  crypto_regulation
  exchange_event
  earnings
  company_news
  geopolitical
  risk_event
  other
}

enum ImportanceLevel {
  low
  medium
  high
  critical
}

enum AiMode {
  professional_coach
  learning
}

enum LearningTemplateType {
  journal_prompt
  strategy_checklist
  mistake_review
  weekly_review
  risk_explanation
}

enum ReviewType {
  daily
  weekly
  mistake
  risk
  strategy
}

enum ReviewStatus {
  open
  completed
  skipped
}

enum IdeaType {
  market_observation
  setup_idea
  strategy_improvement
  risk_rule_idea
  lesson_learned
  backtest_idea
  news_context_note
}

enum IdeaStatus {
  draft
  watching
  tested
  converted_to_plan
  archived
}

model User {
  id                 String               @id @default(cuid())
  email              String               @unique
  name               String
  passwordHash       String
  locale             Locale               @default(en)
  timezone           String               @default("UTC")
  theme              Theme                @default(dark)
  riskPerTradePct    Decimal              @default(1.0) @db.Decimal(8, 4)
  maxDailyLossPct    Decimal              @default(3.0) @db.Decimal(8, 4)
  maxWeeklyLossPct   Decimal              @default(6.0) @db.Decimal(8, 4)
  /// Account balance when the journal starts; lets drawdown be shown as a share of the account.
  startingBalance    Decimal?             @db.Decimal(18, 2)
  /// The broker's server-time zone for MT5 reports ("mt5:new-york-close" or an IANA zone); null = New York close.
  brokerTimeZone     String?
  /// First-run answers: how the person trades ("mt5" | "other" | "manual") and what they want first
  /// ("discipline" | "risk" | "performance" | "strategy"). Both stay null until answered.
  tradingPlatform    String?
  primaryGoal        String?
  /// When the first-run steps were finished or skipped; null = not seen yet.
  onboardedAt        DateTime?
  /// When the labelled sample workspace was loaded into this account; null = no sample data.
  sampleLoadedAt     DateTime?
  twoFactorEnabled   Boolean              @default(false)
  twoFactorSecret    String?
  emailVerifiedAt    DateTime?
  tier               Tier                 @default(free)
  tierExpiresAt      DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  sessions           Session[]
  oauthAccounts      OAuthAccount[]
  resetTokens        PasswordResetToken[]
  roles              UserRole[]
  riskProfile        RiskProfile?
  watchlists         Watchlist[]
  portfolios         Portfolio[]
  trades             Trade[]
  journalEntries     TradeJournalEntry[]
  tradePlans         TradePlan[]
  tradeImports       TradeImport[]
  strategies         Strategy[]
  backtests          Backtest[]
  performanceSummaries PerformanceSummary[]
  alerts             Alert[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  uploadedFiles      UploadedFile[]
  symbolNotes        SymbolNote[]
  newsAnalyses       NewsAnalysis[]
  marketContexts     MarketContext[]
  aiReviews          AiReview[]
  reviews            Review[]
  ideas              Idea[]
  mistakeTags        MistakeTag[]
  emotionTags        EmotionTag[]
  tradingSessions    TradingSession[]
  onboardingProfile  OnboardingProfile?
  payments           Payment[]
}

/// Manual-review purchase (card-to-card or USDT on TRC20). Kept for accounting when the user deletes
/// their account: userId becomes null and no name, email, card number or wallet is stored here.
/// A USDT purchase starts as awaiting_transfer with its exact amount reserved, then becomes pending.
/// trackingCode is the bank reference number (RRN) or the lower-cased on-chain transaction hash;
/// claimCode holds the same value while the claim is live and is cleared on rejection, so a rejected
/// claim never blocks the real payer.
model Payment {
  id              String          @id @default(cuid())
  userId          String?
  user            User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  tier            Tier
  periodDays      Int
  amount          Decimal         @db.Decimal(18, 6)
  currency        PaymentCurrency
  method          PaymentMethod
  trackingCode    String?
  claimCode       String?
  paidAt          DateTime?
  status          PaymentStatus   @default(pending)
  /// Approve/reject decision; never overwritten by a later refund.
  reviewedAt      DateTime?
  reviewedById    String?
  reviewNote      String?
  /// Recorded at approval: no earlier approved or refunded purchase existed for this user.
  isFirstPurchase Boolean         @default(false)
  refundedAt      DateTime?
  refundedById    String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([method, claimCode])
  @@index([status, createdAt])
  @@index([userId])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  accessTokenHash   String?
  refreshTokenHash  String?
  expiresAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Asset {
  id          String       @id @default(cuid())
  symbol      String
  name        String
  market      MarketType
  baseAsset   String?
  quoteAsset  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  trades      Trade[]
  holdings    PortfolioHolding[]
  watchItems  WatchlistItem[]
  transactions PortfolioTransaction[]
  symbolNotes SymbolNote[]
  newsItems   NewsItem[]

  @@unique([symbol, market])
}

model Watchlist {
  id        String          @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WatchlistItem[]

  @@index([userId])
}

model WatchlistItem {
  id          String     @id @default(cuid())
  watchlistId String
  assetId     String?
  symbol      String
  market      MarketType
  notes       String?
  strategyNotes String?
  createdAt   DateTime   @default(now())
  watchlist   Watchlist  @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  asset       Asset?     @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@unique([watchlistId, symbol, market])
}

model SymbolNote {
  id        String     @id @default(cuid())
  userId    String
  assetId   String?
  symbol    String
  market    MarketType
  notes     String
  strategySuitability String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset     Asset?     @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([symbol])
}

model Portfolio {
  id           String                 @id @default(cuid())
  userId       String
  name         String
  baseCurrency String                 @default("USD")
  cashBalance  Decimal                @default(0) @db.Decimal(18, 6)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  holdings     PortfolioHolding[]
  transactions PortfolioTransaction[]
  trades       Trade[]

  @@index([userId])
}

model PortfolioHolding {
  id            String    @id @default(cuid())
  portfolioId   String
  assetId       String
  quantity      Decimal   @default(0) @db.Decimal(28, 10)
  averageEntry  Decimal   @default(0) @db.Decimal(18, 6)
  realizedPnl   Decimal   @default(0) @db.Decimal(18, 6)
  updatedAt     DateTime  @updatedAt
  portfolio     Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  asset         Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, assetId])
}

model PortfolioTransaction {
  id          String     @id @default(cuid())
  portfolioId String
  assetId     String
  side        TradeSide
  quantity    Decimal    @db.Decimal(28, 10)
  price       Decimal    @db.Decimal(18, 6)
  fees        Decimal    @default(0) @db.Decimal(18, 6)
  executedAt  DateTime
  notes       String?
  createdAt   DateTime   @default(now())
  portfolio   Portfolio  @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  asset       Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
  @@index([assetId])
}

model Strategy {
  id              String     @id @default(cuid())
  userId          String
  name            String
  description     String?
  entryRules      Json
  exitRules       Json
  invalidationRules Json
  riskRules       Json
  allowedMarkets  MarketType[]
  timeframes      String[]
  allowedSessions String[]
  checklist       String[]
  commonMistakes  String[]
  idealMarketConditions String[]
  tags            String[]
  /// Optional numeric limits a plan made from this strategy is checked against: risk per trade and daily
  /// loss as a percent of the account, and how many positions may be open at once.
  riskPerTradePct  Decimal?  @db.Decimal(8, 4)
  maxDailyLossPct  Decimal?  @db.Decimal(8, 4)
  maxOpenPositions Int?
  /// Part of the labelled sample workspace (removed with it); never set on a person's own rows.
  isSample        Boolean    @default(false)
  status          String      @default("active")
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades          Trade[]
  tradePlans      TradePlan[]
  backtests       Backtest[]
  versions        StrategyVersion[]
  ideas           Idea[]

  @@index([userId])
}

model StrategyVersion {
  id          String   @id @default(cuid())
  strategyId  String
  version     Int
  changeNote  String
  snapshot    Json
  createdAt   DateTime @default(now())
  strategy    Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@unique([strategyId, version])
}

model Trade {
  id           String              @id @default(cuid())
  userId       String
  portfolioId  String?
  assetId      String?
  strategyId   String?
  tradeImportRowId String? @unique
  /// What the legs of one entry share (account, symbol, direction, "k/N" family or initial stop); the
  /// entry itself is found from open times (src/lib/calculations/ladders.ts).
  ladderKey    String?
  /// The leg's number within its entry ("k" of an EA's "k/N" comment).
  ladderLeg    Int?
  /// Legs the entry was split into, when known (an EA's "k/N" comments); fewer recorded legs = incomplete.
  ladderSize   Int?
  /// The source's id for an imported position ("mt5:<account>:<position>"), so a re-import skips it.
  externalId   String?
  symbol       String
  market       MarketType
  side         TradeSide
  status       TradeStatus         @default(open)
  entryPrice   Decimal             @db.Decimal(18, 6)
  exitPrice    Decimal?            @db.Decimal(18, 6)
  stopLoss     Decimal?            @db.Decimal(18, 6)
  takeProfit   Decimal?            @db.Decimal(18, 6)
  quantity     Decimal             @db.Decimal(28, 10)
  riskAmount   Decimal?            @db.Decimal(18, 6)
  riskPercent  Decimal?            @db.Decimal(8, 4)
  rMultiple    Decimal?            @db.Decimal(12, 4)
  realizedPnl  Decimal?            @db.Decimal(18, 6)
  fees         Decimal             @default(0) @db.Decimal(18, 6)
  session      String?
  setupType    String?
  confidenceScore Int?
  preTradeNotes String?
  postTradeNotes String?
  lessonsLearned String?
  ruleFollowed RuleFollowStatus    @default(unknown)
  outcome      String?
  /// Part of the labelled sample workspace (removed with it); never set on a person's own rows.
  isSample     Boolean             @default(false)
  openedAt     DateTime
  closedAt     DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolio    Portfolio?          @relation(fields: [portfolioId], references: [id], onDelete: SetNull)
  asset        Asset?              @relation(fields: [assetId], references: [id], onDelete: SetNull)
  strategy     Strategy?           @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  importRow    TradeImportRow?     @relation(fields: [tradeImportRowId], references: [id], onDelete: SetNull)
  journalEntry TradeJournalEntry?
  newsItems    NewsItem[]          @relation("TradeNews")
  convertedPlans TradePlan[]
  attachments  UploadedFile[]

  @@index([userId])
  @@index([portfolioId])
  @@index([symbol])
  @@index([openedAt])
  @@index([userId, ladderKey])
  @@unique([userId, externalId])
}

model TradeJournalEntry {
  id             String   @id @default(cuid())
  userId         String
  tradeId        String   @unique
  emotionalState String?
  mistakes       String[]
  tags           String[]
  notes          String?
  preTradeNotes  String?
  postTradeNotes String?
  lessonsLearned String?
  ruleFollowed   RuleFollowStatus @default(unknown)
  review         String?
  screenshotUrl  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trade          Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TradeImport {
  id             String            @id @default(cuid())
  userId         String
  filename       String?
  sourceType     String            @default("trademaster_csv")
  status         TradeImportStatus @default(preview)
  mapping        Json
  totalRows      Int               @default(0)
  validRows      Int               @default(0)
  invalidRows    Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  rows           TradeImportRow[]

  @@index([userId])
  @@index([status])
}

model TradeImportRow {
  id             String      @id @default(cuid())
  tradeImportId  String
  rowNumber      Int
  rawData        Json
  mappedData     Json?
  isValid        Boolean
  errors         String[]
  importedTrade  Trade?
  createdAt      DateTime    @default(now())
  tradeImport    TradeImport @relation(fields: [tradeImportId], references: [id], onDelete: Cascade)

  @@index([tradeImportId])
  @@index([isValid])
}

model TradePlan {
  id             String          @id @default(cuid())
  userId         String
  strategyId     String?
  convertedTradeId String?
  market         MarketType
  symbol         String
  bias           String
  entryZone      String
  stopLoss       Decimal?        @db.Decimal(18, 6)
  takeProfit     Decimal?        @db.Decimal(18, 6)
  riskAmount     Decimal?        @db.Decimal(18, 6)
  riskPercent    Decimal?        @db.Decimal(8, 4)
  checklist      Json
  invalidationRule String?
  relevantNews   String?
  notes          String?
  /// What the risk desk worked out for this plan (volume, legs, the numbers it used); see planSizingSchema.
  sizing         Json?
  /// Part of the labelled sample workspace (removed with it); never set on a person's own rows.
  isSample       Boolean         @default(false)
  status         TradePlanStatus @default(planned)
  plannedFor     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategy       Strategy?       @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  convertedTrade Trade?          @relation(fields: [convertedTradeId], references: [id], onDelete: SetNull)
  convertedIdeas Idea[]
  newsItems      NewsItem[]      @relation("PlanNews")
  attachments    UploadedFile[]

  @@index([userId])
  @@index([status])
  @@index([symbol])
}

model Backtest {
  id              String   @id @default(cuid())
  userId          String
  strategyId      String?
  name            String
  market          MarketType
  timeframe       String
  startingBalance Decimal  @db.Decimal(18, 6)
  result          Json
  trades          Json
  equityCurve     Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategy        Strategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model PerformanceSummary {
  id          String   @id @default(cuid())
  userId      String
  periodStart DateTime
  periodEnd   DateTime
  scope       String
  metrics     Json
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([periodStart, periodEnd])
}

model RiskProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  accountSize    Decimal  @default(25000) @db.Decimal(18, 6)
  riskPerTradePct Decimal @default(1) @db.Decimal(8, 4)
  maxDailyRiskPct Decimal @default(3) @db.Decimal(8, 4)
  maxWeeklyRiskPct Decimal @default(6) @db.Decimal(8, 4)
  maxOpenRiskPct Decimal @default(5) @db.Decimal(8, 4)
  rules          Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Alert {
  id        String      @id @default(cuid())
  userId    String
  type      AlertType
  status    AlertStatus @default(active)
  symbol    String?
  condition Json
  message   String
  channels  NotificationChannel[]
  triggeredAt DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  channel   NotificationChannel
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime            @default(now())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([readAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model UploadedFile {
  id          String   @id @default(cuid())
  userId      String
  tradeId     String?
  tradePlanId String?
  filename    String
  mimeType    String
  sizeBytes   Int
  storageKey  String
  checksum    String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trade       Trade?   @relation(fields: [tradeId], references: [id], onDelete: SetNull)
  tradePlan   TradePlan? @relation(fields: [tradePlanId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsItem {
  id              String          @id @default(cuid())
  assetId         String?
  title           String
  source          String
  url             String?
  publishedAt     DateTime
  language        Locale
  market          MarketType
  relatedSymbols  String[]
  category        NewsCategory
  importance      ImportanceLevel @default(medium)
  sentiment       String
  summary         String
  possibleAffectedAssets String[]
  riskNotes       String[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  asset           Asset?          @relation(fields: [assetId], references: [id], onDelete: SetNull)
  analyses        NewsAnalysis[]
  linkedTrades    Trade[]         @relation("TradeNews")
  linkedPlans     TradePlan[]     @relation("PlanNews")

  @@index([market])
  @@index([language])
  @@index([publishedAt])
}

model NewsAnalysis {
  id              String          @id @default(cuid())
  userId          String?
  newsItemId      String
  mode            AiMode          @default(professional_coach)
  whatHappened    String
  affectedMarket  MarketType
  impactLevel     ImportanceLevel
  cautionNotes    String[]
  conflicts       Json
  reviewChecklist String[]
  createdAt       DateTime        @default(now())
  user            User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  newsItem        NewsItem        @relation(fields: [newsItemId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([newsItemId])
}

model MarketContext {
  id          String   @id @default(cuid())
  userId      String
  market      MarketType
  symbol      String?
  language    Locale
  summary     String
  risks       String[]
  reviewItems String[]
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([market])
}

model AiReview {
  id          String   @id @default(cuid())
  userId      String
  mode        AiMode
  workflow    String
  subjectId   String?
  input       Json
  output      Json
  disclaimer  String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([workflow])
}

model Review {
  id                String       @id @default(cuid())
  userId            String
  type              ReviewType
  status            ReviewStatus @default(open)
  periodStart       DateTime
  periodEnd         DateTime
  title             String
  checklist         Json
  metrics           Json?
  insights          String[]
  risks             String[]
  lessons           String[]
  nextActions       String[]
  linkedTradeIds    String[]
  linkedStrategyIds String[]
  /// Part of the labelled sample workspace (removed with it); never set on a person's own rows.
  isSample          Boolean      @default(false)
  completedAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([periodStart, periodEnd])
}

model Idea {
  id                    String     @id @default(cuid())
  userId                String
  title                 String
  market                MarketType
  symbols               String[]
  type                  IdeaType
  status                IdeaStatus @default(draft)
  thesis                String
  invalidation          String?
  relatedStrategyId     String?
  relatedWatchlistSymbol String?
  relatedNewsContext    String?
  confidence            Int        @default(5)
  tags                  String[]
  convertedTradePlanId  String?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  user                  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  relatedStrategy       Strategy?  @relation(fields: [relatedStrategyId], references: [id], onDelete: SetNull)
  convertedTradePlan    TradePlan? @relation(fields: [convertedTradePlanId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([market])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model LearningGlossary {
  id          String   @id @default(cuid())
  term        String
  language    Locale
  level       String
  definition  String
  example     String?
  relatedTerms String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([term, language])
}

model LearningTemplate {
  id          String               @id @default(cuid())
  type        LearningTemplateType
  language    Locale
  title       String
  content     Json
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([type])
  @@index([language])
}

model MistakeTag {
  id          String   @id @default(cuid())
  userId      String?
  key         String
  label       String
  language    Locale   @default(en)
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key, language])
}

model EmotionTag {
  id          String   @id @default(cuid())
  userId      String?
  key         String
  label       String
  language    Locale   @default(en)
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key, language])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  enabled     Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum TradingSessionStatus {
  active
  completed
  abandoned
}

model TradingSession {
  id                 String               @id @default(cuid())
  userId             String
  status             TradingSessionStatus @default(active)
  market             MarketType
  sessionLabel       String
  emotionalState     String?
  maxDailyLoss       Decimal?             @db.Decimal(8, 4)
  allowedStrategyIds String[]
  mistakeToAvoid     String?
  notes              String?
  startedAt          DateTime             @default(now())
  endedAt            DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([startedAt])
}

model OnboardingProfile {
  id                  String     @id @default(cuid())
  userId              String     @unique
  experience          String
  market              MarketType
  disciplineIssue     String
  language            Locale
  segment             String
  defaultRiskPercent  Decimal    @db.Decimal(8, 4)
  focusAreas          String[]
  recommendedFeatures String[]
  startingChecklist   String[]
  sprint              Json
  starterStrategyId   String?
  firstReviewId       String?
  completedAt         DateTime   @default(now())
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([segment])
  @@index([completedAt])
}

/// A request for a trial invite, sent from the public "request access" page. It holds only what the person typed:
/// no IP address and no user agent. The e-mail is stored lower-cased and is unique, so a repeat request updates the
/// row instead of adding one. status is "new" | "invited" | "declined" and is changed only by an admin.
model AccessRequest {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  /// "mt5" | "other" | "manual"
  tradingPlatform String?
  note            String?
  locale          Locale   @default(fa)
  status          String   @default("new")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, createdAt])
}
